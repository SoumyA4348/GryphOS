# MongoDB connection (defaults to containerized mongo service in docker compose)
MONGO_URL=mongodb://localhost:27017/gryph-os
DB_NAME=gryph-os

# Gemini AI Integration (for syllabus deadline extraction)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# AWS Services (Cognito Auth & S3 Storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=your_user_pool_id
COGNITO_CLIENT_ID=your_client_id
COGNITO_CLIENT_SECRET=
S3_BUCKET=your_s3_bucket_name

# App Security & CORS
JWT_SECRET=dev-secret-key-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
